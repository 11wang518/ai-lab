{
  "name": "ai-lab-desktop",
  "version": "1.0.0",
  "description": "AI Lab 桌面客户端（Electron 外壳）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "local.ailab.desktop",
    "productName": "AI Lab",
    "files": ["main.js", "preload.js"],
    "win": { "target": ["portable"] }
  }
}
